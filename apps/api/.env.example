# ============================================================
# CẤU HÌNH MẪU BACKEND (apps/api/.env.example)
# Sao chép thành apps/api/.env hoặc apps/api/.env.local khi chạy local
# ============================================================

# Cổng khởi chạy server backend Express
PORT=5003
NODE_ENV=development

# Kết nối PostgreSQL (Supabase Connection String / Pooler qua cổng 5432 hoặc 6543)
DATABASE_URL=postgresql://postgres.czngbleeeiljsrpbaksg:B1gh13u1977dtnt@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Project URL dùng để xác minh JWT JWKS qua Supabase Auth
SUPABASE_URL=https://czngbleeeiljsrpbaksg.supabase.co

# Email Super Admin
SUPER_ADMIN_EMAIL=hoang.hoa@gmail.com

# Danh sách domain frontend được phép gọi API (CORS), phân tách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176,http://localhost:3000,http://localhost:5003

# Cấu hình SSL / Pool cho kết nối PostgreSQL
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=5

# Gemini API Keys cho AI Ingest/chấm bài (xoay vòng tối đa 3 key)
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=

# Secret token ký xác thực các route AI nội bộ
SIGNING_SECRET=cyber-english-secret-signing-key-2026
