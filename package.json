{
  "name": "mikawaii-monorepo",
  "private": true,
  "packageManager": "npm@11.6.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=web",
    "build:api": "turbo build --filter=api",
    "dev:web": "turbo dev --filter=web",
    "dev:api": "turbo dev --filter=api",
    "test": "turbo test",
    "lint": "turbo lint",
    "migrate": "npm run migrate --workspace=api"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
